# ─────────────────────────────────────────────────────────────
# Mafia Night environment
# Copy to .env.local and fill the values.
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional alias if your Neon integration exposes POSTGRES_URL instead.
POSTGRES_URL=""

# Upstash / Vercel KV compatible values.
# The app prefers REDIS_URL when present, otherwise KV_REST_API_URL + token.
REDIS_URL=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""
KV_URL=""
KV_REST_API_URL=""

# AI story provider. The endpoint is OpenAI-compatible.
AI_API_KEY=""
AI_MODEL=""
# Optional. Leave blank for OpenAI-compatible default.
AI_API_URL="https://api.openai.com/v1/chat/completions"

# Public app URL. Local default is fine during development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side security secret. Generate a long random value.
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: set to true to use template stories even when an AI key exists.
STORY_AI_DISABLED="false"
