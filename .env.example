# ─────────────────────────────────────────────────────────────
# Mafia Night environment
# Copy to .env.local and fill the values.
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional alias if your Neon integration exposes POSTGRES_URL instead.
POSTGRES_URL=""

# Upstash REST values. Required on Render so rooms survive restarts.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# AI story provider. The endpoint is OpenAI-compatible.
AI_API_KEY=""
AI_MODEL=""
# Optional. Leave blank for OpenAI-compatible default.
AI_API_URL="https://api.openai.com/v1/chat/completions"

# Public app URL. Local default is fine during development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public Render origin used by the browser for HTTPS and WSS.
# Leave empty for local combined development on http://localhost:3000.
NEXT_PUBLIC_GAME_SERVER_URL=""

# Render only: exact browser origins allowed to call/connect to the game server.
# Separate multiple origins with commas. Do not use a wildcard in production.
ALLOWED_ORIGINS="http://localhost:3000"

# Reserved for future signed account sessions. It is never exposed to the browser.
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: set to true to use template stories even when an AI key exists.
STORY_AI_DISABLED="false"
